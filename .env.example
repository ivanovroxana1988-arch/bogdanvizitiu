# Google Search Console URL-prefix verification fallback.
# Prefer a Domain property for bogdanvizitiu.com and verify it through DNS.
# Do not commit the real verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form delivery through Resend.
# Store the real API key only in Vercel environment variables.
RESEND_API_KEY=

# Must use a sender address on a domain verified in Resend.
# Example: Bogdan Vizitiu <formular@send.bogdanvizitiu.com>
CONTACT_FROM_EMAIL=

# Contact form rate limiting.
# Defaults are 5 requests per 600-second fixed window per hashed client identifier.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600

# Optional durable backend for the contact rate limiter.
# Without these values, the endpoint falls back to per-instance in-memory limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
